# ---------------------------------------------------------------------------
# SPEC-INFRA-01 / SPEC-INFRA-03
# Chuyển đổi giữa hai cấu hình CHỈ bằng các biến dưới đây. Không sửa mã nguồn.
# ---------------------------------------------------------------------------

# Cấu hình tham chiếu của lớp: S (server dùng chung) hoặc L (chạy cục bộ).
# Giá trị mặc định là L theo nguyên tắc chọn khi phân vân của SPEC-INFRA-02.
# Đơn vị tổ chức đo năng lực server trước khóa 1 tuần rồi sửa dòng này.
CONFIG_PROFILE=L

# --- Cấu hình L: Ollama chạy trên máy học viên -----------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=bge-m3

# --- Cấu hình S: vLLM sau LiteLLM proxy ------------------------------------
# Bỏ chú thích 5 dòng dưới, chú thích 5 dòng trên, và đổi CONFIG_PROFILE=S
# LLM_BASE_URL=http://10.0.0.10:4000/v1
# LLM_MODEL=Qwen3-8B
# LLM_API_KEY=<khóa truy cập theo nhóm, giảng viên cấp>
# EMBED_BASE_URL=http://10.0.0.10:4000/v1
# EMBED_MODEL=bge-m3

# --- Lớp cache: SPEC-LLM-02 ------------------------------------------------
# on         : đọc cache trước, gọi model khi trượt, ghi lại kết quả (mặc định)
# cache_only : KHÔNG gọi model. Trượt cache là lỗi. Đây là lớp dự phòng 3
#              và cũng là chế độ CI chạy trên runner không có GPU.
# off        : luôn gọi model, không đọc không ghi. Chỉ dùng khi đo độ trễ thật.
CACHE_MODE=on
CACHE_PATH=.cache/llm_cache.db

# --- Ngân sách tính toán: SPEC-INFRA-04, ép bằng pytest --------------------
MAX_LLM_CALLS_PER_TICKET=5
MAX_TOOL_CALLS_PER_TICKET=3
MAX_SYSTEM_PROMPT_TOKENS=800
MAX_CONTEXT_TOKENS=3000

# --- Truy hồi: SPEC-RAG-01, SPEC-RAG-02 ------------------------------------
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVE_TOP_K=5
# 0.62 được hiệu chuẩn cho hybrid (bge-m3 + từ khóa) bằng bảng quét ngưỡng ở scripts/lab3_check.py.
# Đổi model embedding, chiến lược chia đoạn hoặc kiểu tìm thì phải hiệu chuẩn lại.
RETRIEVE_MIN_SCORE=0.62
# auto: nhúng truy vấn và chạy hybrid khi chỉ mục có vector, rơi về keyword nếu model embedding không phản hồi
# keyword: luôn chỉ dùng từ khóa
RETRIEVE_MODE=auto
RETRIEVE_VECTOR_WEIGHT=0.75
RERANK_ENABLED=false
EMBED_BATCH_SIZE=16
CHROMA_PATH=data/index

# --- Vận hành --------------------------------------------------------------
DB_PATH=data/app.db
LOG_PATH=logs/app.jsonl
API_WORKERS=2
LLM_TIMEOUT_SECONDS=120
TOOL_TIMEOUT_SECONDS=5
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN=60
